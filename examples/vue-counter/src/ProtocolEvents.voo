<component name="ProtocolEvents">
events:
  zero()
  one(value: i32)
  many(index: i32, enabled: bool, label: String)
</component>

<rust>
use wasm_bindgen::JsValue;

use crate::{EventListener, View, ViewElement};

pub struct Component {
    root: ViewElement,
    _listeners: Vec<EventListener>,
}

impl Component {
    pub fn dispose(&mut self) {
        self.root.remove();
    }
}

pub fn mount(context: Context) -> Result<Component, JsValue> {
    let view = View::from_host(&context.host)?;
    let root = view.element("section")?.attribute("data-vooya-island", "protocol-events")?;
    let mut listeners = Vec::new();
    for (label, emit) in [
        ("Emit zero", 0),
        ("Emit one", 1),
        ("Emit many", 2),
    ] {
        let button = view.element("button")?.attribute("aria-label", label)?.text(label);
        let events = context.events.clone();
        listeners.push(button.on("click", move |_event| {
            let _ = match emit {
                0 => events.zero(),
                1 => events.one(7),
                _ => events.many(3, true, "three".to_owned()),
            };
        })?);
        root.append(&button)?;
    }
    root.mount(&context.host)?;
    Ok(Component { root, _listeners: listeners })
}
</rust>
