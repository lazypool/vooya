<component name="LoopEvents">
events:
  choose(index: i32)
</component>

<rust>
use wasm_bindgen::JsValue;

use crate::{EventListener, View, ViewElement};

pub struct Component {
    root: ViewElement,
    _clicks: Vec<EventListener>,
}

impl Component {
    pub fn dispose(&mut self) {
        self.root.remove();
    }
}

pub fn mount(context: Context) -> Result<Component, JsValue> {
    let view = View::from_host(&context.host)?;
    let root = view.element("section")?.attribute("data-vooya-island", "loop-events")?;
    let label = view.element("p")?.text("Choose a loop-created listener:");
    root.append(&label)?;
    let mut clicks = Vec::new();

    for index in 1..=5_i32 {
        let button = view
            .element("button")?
            .attribute("aria-label", &format!("Choose {index}"))?
            .text(&index.to_string());
        let events = context.events.clone();
        let click = button.on("click", move |_event| {
            let _ = events.choose(index);
        })?;
        root.append(&button)?;
        clicks.push(click);
    }

    root.mount(&context.host)?;
    Ok(Component { root, _clicks: clicks })
}
</rust>
