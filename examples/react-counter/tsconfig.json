{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDirs": [".", ".vooya/types"],
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", ".vooya/types/**/*.ts"]
}
