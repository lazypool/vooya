<component name="Counter">
props:
  initial: i32

events:
  change(value: i32)
</component>

<rust>
use std::{cell::Cell, rc::Rc};

use wasm_bindgen::JsValue;

use crate::{EventListener, View, ViewElement};

pub struct Component {
    root: ViewElement,
    label: ViewElement,
    count: Rc<Cell<i32>>,
    _click: EventListener,
}

impl Component {
    pub fn update_initial(&self, initial: i32) {
        render_count(&self.label, &self.count, initial);
    }

    pub fn dispose(&mut self) {
        self.root.remove();
    }
}

pub fn mount(context: Context) -> Result<Component, JsValue> {
    let host = context.host;
    let initial = context.props.initial;
    let events = context.events;
    let view = View::from_host(&host)?;
    let root = view
        .element("section")?
        .class("vooya-counter")
        .attribute("data-vooya-island", "counter")?;
    let label = view.element("output")?.attribute("data-vooya-count", "")?;
    let button = view.element("button")?.text("Increment");
    root.append(&label)?;
    root.append(&button)?;
    root.mount(&host)?;

    let count = Rc::new(Cell::new(initial));
    render_count(&label, &count, initial);

    let callback_label = label.clone();
    let callback_count = count.clone();
    let click = button.on("click", move |_event| {
        let next = callback_count.get() + 1;
        render_count(&callback_label, &callback_count, next);

        let _ = events.change(next);
    })?;

    Ok(Component {
        root,
        label,
        count,
        _click: click,
    })
}

fn render_count(label: &ViewElement, count: &Cell<i32>, value: i32) {
    count.set(value);
    label.set_text(&value.to_string());
}
</rust>

<style scoped>
.vooya-counter {
    align-items: center;
    display: flex;
    gap: 0.75rem;
}

output {
    font-variant-numeric: tabular-nums;
    min-width: 2rem;
}
</style>
