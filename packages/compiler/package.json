{
  "name": "@vooya/compiler",
  "version": "0.1.0-alpha.4",
  "description": "Pure .voo compiler pipeline for Vooya component islands.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vooyajs/vooya.git",
    "directory": "packages/compiler"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/*.js",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -f src/types.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "postcss": "^8.5.23"
  }
}
