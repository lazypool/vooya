{
  "name": "@voya/vue",
  "version": "0.0.0",
  "description": "Vue host adapter for Voya component islands.",
  "type": "module",
  "private": true,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external vue --tsconfig tsconfig.json --clean"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
