{
  "name": "@voya/react",
  "version": "0.0.0",
  "description": "React host adapter for Voya component islands.",
  "type": "module",
  "private": true,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
