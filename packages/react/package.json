{
  "name": "@vooya/react",
  "version": "0.1.0-alpha.0",
  "description": "React host adapter for Voya component islands.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyajs/voya.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --external react --tsconfig tsconfig.json --clean"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
