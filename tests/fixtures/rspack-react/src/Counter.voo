<component name="Counter">
props:
  initial: i32 = 1

events:
  change(value: i32)
</component>

<rust>
use std::{cell::Cell, rc::Rc}; use wasm_bindgen::JsValue; use crate::{EventListener, View, ViewElement};
pub struct Component { root: ViewElement, value: Rc<Cell<i32>>, output: ViewElement, _click: EventListener }
impl Component { pub fn update_initial(&self, value: i32) { self.value.set(value); self.output.set_text(&value.to_string()); } pub fn dispose(&mut self) { self.root.remove(); } }
pub fn mount(context: Context) -> Result<Component, JsValue> { let view = View::from_host(&context.host)?; let root = view.element("section")?.class("counter"); let output = view.element("output")?.attribute("data-count", "")?; output.set_text(&context.props.initial.to_string()); let button = view.element("button")?.attribute("data-inc", "")?.text("Increment"); root.append(&output)?; root.append(&button)?; root.mount(&context.host)?; let value = Rc::new(Cell::new(context.props.initial)); let next_value = value.clone(); let next_output = output.clone(); let events = context.events; let click = button.on("click", move |_| { let next = next_value.get() + 1; next_value.set(next); next_output.set_text(&next.to_string()); let _ = events.change(next); })?; Ok(Component { root, value, output, _click: click }) }
</rust>

<style scoped>
:host { color: rgb(5, 103, 89); }
</style>
