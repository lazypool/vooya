<component name="PortableCounter">
props:
  initial: i32
</component>

<rust>
use wasm_bindgen::JsValue;

use crate::{View, ViewElement};
use portable_math::display_value;

pub struct Component {
    root: ViewElement,
}

impl Component {
    pub fn update_initial(&self, initial: i32) {
        self.root.set_text(&display_value(initial).to_string());
    }

    pub fn dispose(&mut self) {
        self.root.remove();
    }
}

pub fn mount(context: Context) -> Result<Component, JsValue> {
    let host = context.host;
    let view = View::from_host(&host)?;
    let root = view
        .element("output")?
        .class("portable-counter")
        .text(&display_value(context.props.initial).to_string());
    root.mount(&host)?;
    Ok(Component { root })
}
</rust>

<style scoped>
.portable-counter {
    font-variant-numeric: tabular-nums;
}
</style>
