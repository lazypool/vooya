<component name="Counter">
props:
  initial: i32 = 1
</component>

<rust>
use wasm_bindgen::JsValue; use crate::{View, ViewElement};
pub struct Component { root: ViewElement, output: ViewElement }
impl Component { pub fn update_initial(&self, value: i32) { self.output.set_text(&value.to_string()); } pub fn dispose(&mut self) { self.root.remove(); } }
pub fn mount(context: Context) -> Result<Component, JsValue> { let view = View::from_host(&context.host)?; let root = view.element("section")?.class("counter"); let output = view.element("output")?.attribute("data-count", "")?; output.set_text(&context.props.initial.to_string()); root.append(&output)?; root.mount(&context.host)?; Ok(Component { root, output }) }
</rust>

<style scoped>
:host { color: rgb(5, 103, 89); }
</style>
