<component name="PortableCounter">
props:
  initial: i32
</component>

<rust>
use wasm_bindgen::JsValue;
use crate::{View, ViewElement};

pub struct Component { root: ViewElement }

impl Component {
    pub fn update_initial(&self, initial: i32) { self.root.set_text(&initial.to_string()); }
    pub fn dispose(&mut self) { self.root.remove(); }
}

pub fn mount(context: Context) -> Result<Component, JsValue> {
    let host = context.host;
    let view = View::from_host(&host)?;
    let root = view.element("output")?.class("vooya-portable-counter").text(&context.props.initial.to_string());
    root.mount(&host)?;
    Ok(Component { root })
}
</rust>
