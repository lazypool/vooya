{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "source",
    "outDir": "generated",
    "declaration": false,
    "noEmitOnError": true,
    "sourceMap": false
  },
  "include": ["source/**/*.ts"]
}
