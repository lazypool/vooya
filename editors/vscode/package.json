{
  "name": "voo",
  "displayName": "Vooya",
  "description": "Language support for Vooya .voo Rust components.",
  "version": "0.1.0",
  "type": "module",
  "publisher": "vooya",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:extension-host": "node test/run-extension-host.mjs"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vooyajs/vooya.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:voo",
    "onCommand:vooya.checkEmbeddedRust"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vooya",
    "voo",
    "rust",
    "wasm"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vooya.checkEmbeddedRust",
        "title": "Vooya: Check Embedded Rust"
      }
    ],
    "languages": [
      {
        "id": "voo",
        "aliases": [
          "Voo",
          "voo"
        ],
        "extensions": [
          ".voo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "voo",
        "scopeName": "source.voo",
        "path": "./syntaxes/voo.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.css": "css"
        }
      }
    ]
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0"
  }
}
