{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Voo",
  "scopeName": "source.voo",
  "patterns": [
    { "include": "#source-component" },
    { "include": "#rust-block" },
    { "include": "#style-block" },
    { "include": "#manifest" },
    { "include": "#comment" }
  ],
  "repository": {
    "source-component": {
      "name": "meta.block.component.voo",
      "begin": "(<)(component)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.voo" },
        "2": { "name": "entity.name.tag.voo" },
        "3": { "patterns": [{ "include": "#tag-attributes" }] },
        "4": { "name": "punctuation.definition.tag.end.voo" }
      },
      "end": "(</)(component)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.voo" },
        "2": { "name": "entity.name.tag.voo" },
        "3": { "name": "punctuation.definition.tag.end.voo" }
      },
      "patterns": [
        { "include": "#comment" },
        {
          "match": "^(\\s*)(props|events)(:)",
          "captures": {
            "2": { "name": "keyword.control.section.voo" },
            "3": { "name": "punctuation.separator.key-value.voo" }
          }
        },
        {
          "match": "^(\\s*)([A-Za-z_][\\w]*)(\\s*)(:)(\\s*)([^=]+?)(?:\\s*(=)\\s*(.+?))?(\\s*)(//.*)?$",
          "captures": {
            "2": { "name": "variable.other.member.voo" },
            "4": { "name": "punctuation.separator.key-value.voo" },
            "6": { "name": "entity.name.type.rust" },
            "7": { "name": "keyword.operator.assignment.voo" },
            "8": { "name": "meta.embedded.inline.rust" },
            "10": { "name": "comment.line.double-slash.voo" }
          }
        },
        {
          "match": "^(\\s*)([A-Za-z_][\\w-]*)(\\()(.+)(\\))(\\s*)(//.*)?$",
          "captures": {
            "2": { "name": "entity.name.function.event.voo" },
            "3": { "name": "punctuation.definition.parameters.begin.voo" },
            "4": { "name": "meta.parameters.event.voo" },
            "5": { "name": "punctuation.definition.parameters.end.voo" },
            "7": { "name": "comment.line.double-slash.voo" }
          }
        }
      ]
    },
    "rust-block": {
      "name": "meta.embedded.block.rust",
      "contentName": "meta.embedded.block.rust",
      "begin": "(<)(rust)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.voo" },
        "2": { "name": "entity.name.tag.voo" },
        "3": { "name": "punctuation.definition.tag.end.voo" }
      },
      "end": "(</)(rust)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.voo" },
        "2": { "name": "entity.name.tag.voo" },
        "3": { "name": "punctuation.definition.tag.end.voo" }
      },
      "patterns": [
        { "include": "source.rust" }
      ]
    },
    "style-block": {
      "name": "meta.embedded.block.css",
      "contentName": "meta.embedded.block.css",
      "begin": "(<)(style)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.voo" },
        "2": { "name": "entity.name.tag.voo" },
        "3": { "patterns": [{ "include": "#tag-attributes" }] },
        "4": { "name": "punctuation.definition.tag.end.voo" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.voo" },
        "2": { "name": "entity.name.tag.voo" },
        "3": { "name": "punctuation.definition.tag.end.voo" }
      },
      "patterns": [
        { "include": "source.css" }
      ]
    },
    "manifest": {
      "patterns": [
        {
          "match": "^(component)(\\s+)([A-Z][A-Za-z0-9_]*)$",
          "captures": {
            "1": { "name": "storage.type.component.voo" },
            "3": { "name": "entity.name.type.component.voo" }
          }
        },
        {
          "match": "^(\\s*)(adapter|props|events)(:)",
          "captures": {
            "2": { "name": "keyword.control.section.voo" },
            "3": { "name": "punctuation.separator.key-value.voo" }
          }
        },
        {
          "match": "^(\\s*)(runtime|export)(\\s*)(:)(\\s*)(.+)$",
          "captures": {
            "2": { "name": "variable.other.member.voo" },
            "4": { "name": "punctuation.separator.key-value.voo" },
            "6": { "name": "string.unquoted.voo" }
          }
        },
        {
          "match": "^(\\s*)(vue|react)(\\s*)(:)(\\s*)([A-Za-z_$][\\w$]*)$",
          "captures": {
            "2": { "name": "support.type.framework.voo" },
            "4": { "name": "punctuation.separator.key-value.voo" },
            "6": { "name": "entity.name.function.adapter.voo" }
          }
        }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "match": "([A-Za-z_][\\w-]*)(?:\\s*(=)\\s*(\"[^\"]*\"))?",
          "captures": {
            "1": { "name": "entity.other.attribute-name.voo" },
            "2": { "name": "punctuation.separator.key-value.voo" },
            "3": { "name": "string.quoted.double.voo" }
          }
        }
      ]
    },
    "comment": {
      "name": "comment.line.double-slash.voo",
      "match": "//.*$"
    }
  }
}
